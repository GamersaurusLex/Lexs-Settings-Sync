<div class="settings-sync-app">
  <input class="settings-sync-file" type="file" accept="application/json,.json" hidden>
  {{#if isLibrary}}
    <header class="settings-sync-summary">
      <div><strong>Saved profile library</strong><small>Profiles live in Foundry’s data folder and are available to worlds on this server.</small></div>
    </header>
    <div class="settings-sync-main">
      <div class="settings-sync-actions">
        <button type="button" data-action="closeLibrary"><i class="fa-solid fa-arrow-left"></i> Back</button>
        <button type="button" data-action="chooseProfile"><i class="fa-solid fa-file-import"></i> Import JSON file</button>
      </div>
      {{#if library.length}}
        <section class="settings-sync-section library">
          <h2>Saved profiles</h2>
          <ul>{{#each library}}<li><label><span class="settings-sync-setting-copy"><strong>{{name}}</strong><small>{{systemId}} · {{fileName}}</small></span></label><button type="button" data-action="openLibraryProfile" data-path="{{path}}">Open</button></li>{{/each}}</ul>
        </section>
      {{else}}<p class="hint">The library is empty. Create a profile from a source world, then save it here.</p>{{/if}}
    </div>
  {{else}}
    {{#if hasProfile}}
      <div class="settings-sync-heading">
        <header class="settings-sync-summary">
          <div><strong>{{profile.name}}</strong><small>{{profile.systemId}} profile · saved {{#if profile.savedAt}}{{profile.savedAt}}{{else}}{{profile.exportedAt}}{{/if}}</small></div>
          <div class="settings-sync-count"><strong>{{applyCount}}</strong><small>selected defaults</small></div>
          <div class="settings-sync-count"><strong>{{reviewCount}}</strong><small>need review</small></div>
        </header>
        {{#unless isCompatible}}<p class="settings-sync-alert"><i class="fa-solid fa-triangle-exclamation"></i> This {{profile.systemId}} profile cannot apply to a {{targetSystemId}} world.</p>{{/unless}}
        {{#if isPaizoCrossSystem}}<p class="settings-sync-alert"><i class="fa-solid fa-circle-info"></i> Shared PF2e/SF2e settings can apply here. {{profile.systemId}} system settings stay excluded.</p>{{/if}}
        {{#if settingsVaultActive}}<p class="settings-sync-alert"><i class="fa-solid fa-triangle-exclamation"></i> Settings Vault is active. Its settings are protected from this profile.</p>{{/if}}
      </div>

      <div class="settings-sync-main">
        <div class="settings-sync-actions">
          <button type="button" data-action="showLibrary"><i class="fa-solid fa-folder-open"></i> Browse profiles</button>
          <button type="button" data-action="chooseProfile"><i class="fa-solid fa-file-import"></i> Import JSON</button>
          <button type="button" data-action="saveProfile"><i class="fa-solid fa-floppy-disk"></i> Save as profile</button>
          <button type="button" data-action="downloadProfile"><i class="fa-solid fa-download"></i> Download copy</button>
          <button type="button" data-action="clearProfile"><i class="fa-solid fa-xmark"></i> Clear</button>
        </div>

        <section class="settings-sync-section recommended">
          <h2>Profile defaults <span>{{recommended.length}}</span></h2>
          <p>Selected values follow the profile’s Always sync rules. They do not apply until you review and confirm them.</p>
          {{#if recommended.length}}
            <ul>{{#each recommended}}<li><label><input type="checkbox" data-row-index="{{rowIndex}}" {{checked selected}}> <span class="settings-sync-setting-copy"><strong>{{settingLabel}}</strong>{{#if settingHint}}<small>{{settingHint}}</small>{{/if}}<small>Profile: {{profileValue}} · This world: {{targetValue}}</small></span></label></li>{{/each}}</ul>
          {{else}}<p class="hint">Nothing needs changing.</p>{{/if}}
        </section>

        <section class="settings-sync-section review">
          <h2>Needs your decision <span>{{review.length}}</span></h2>
          <p>Select a setting to apply it once, then choose whether it should inherit the module rule or get its own rule.</p>
          {{#if review.length}}
            <ul>{{#each review}}<li>
              <label><input type="checkbox" data-row-index="{{rowIndex}}" {{checked selected}}> <span class="settings-sync-setting-copy"><strong>{{settingLabel}}</strong>{{#if settingHint}}<small>{{settingHint}}</small>{{/if}}<small>{{reason}} · Profile: {{profileValue}} · This world: {{targetValue}}</small></span></label>
              <select data-policy-setting="{{fullKey}}">
                <option value="inherit" {{#if (eq settingPolicy "inherit")}}selected{{/if}}>Use module rule</option>
                <option value="always" {{#if (eq settingPolicy "always")}}selected{{/if}}>Always sync this setting</option>
                <option value="review" {{#if (eq settingPolicy "review")}}selected{{/if}}>Review this setting</option>
                <option value="never" {{#if (eq settingPolicy "never")}}selected{{/if}}>Never sync this setting</option>
                <option value="global-never">Never sync in any profile</option>
              </select>
            </li>{{/each}}</ul>
          {{else}}<p class="hint">Nothing is waiting on a setting-by-setting decision.</p>{{/if}}
        </section>

        <section class="settings-sync-section modules">
          <h2>Module state <span>{{moduleActions.length}}</span></h2>
          <p>Profile modules can activate only after confirmation. Target-world modules stay untouched until you make a choice.</p>
          {{#if moduleActions.length}}
            <ul>{{#each moduleActions}}<li>
              {{#if (eq status "target-only")}}
                <select data-target-module="{{moduleIndex}}">
                  <option value="ignore" selected>Ignore once</option>
                  <option value="keep">Keep as campaign-specific</option>
                  <option value="add-required">Add to profile: required</option>
                  <option value="add-optional">Add to profile: optional</option>
                  <option value="deactivate">Deactivate in this world</option>
                </select>
              {{else}}<input type="checkbox" data-module-index="{{moduleIndex}}" {{checked selected}}>{{/if}}
              <label><strong>{{title}}</strong><small>{{reason}}</small></label>
            </li>{{/each}}</ul>
          {{else}}<p class="hint">The active module set already matches the profile.</p>{{/if}}
        </section>

        <details class="settings-sync-section policies">
          <summary>Profile rules</summary>
          <p>Set a default for each module. Native Core configuration is handled deliberately; campaign identity, protected local settings, and hidden bookkeeping never transfer.</p>
          <ul>{{#each policyGroups}}<li><strong>{{namespace}}</strong><select data-policy-module="{{namespace}}"><option value="always" {{#if (eq policy "always")}}selected{{/if}}>Always sync</option><option value="review" {{#if (eq policy "review")}}selected{{/if}}>Review</option><option value="never" {{#if (eq policy "never")}}selected{{/if}}>Never sync</option></select></li>{{/each}}</ul>
        </details>

        {{#if unavailable.length}}<details class="settings-sync-section skipped"><summary>{{unavailable.length}} profile module(s) unavailable here</summary><ul>{{#each unavailable}}<li><strong>{{title}}</strong>{{#if manifest}} — <a href="{{manifest}}" target="_blank" rel="noopener">manifest</a>{{/if}}</li>{{/each}}</ul></details>{{/if}}
        <p class="hint settings-sync-internal-note">Invisible Foundry bookkeeping and protected world-local values are excluded automatically.</p>
      </div>

      <footer class="settings-sync-commit">
        <div><strong>Review before applying</strong><small>The next step shows every selected change and asks for confirmation.</small></div>
        <button type="button" data-action="applySelected" {{#unless isCompatible}}disabled{{/unless}}><i class="fa-solid fa-list-check"></i> Review selected changes</button>
      </footer>
    {{else}}
      <p class="settings-sync-lede">Build a system-specific profile from this world, then apply its approved defaults elsewhere. Only settings visible in Foundry’s Settings sidebar are included.</p>
      <div class="settings-sync-actions"><button type="button" data-action="createProfile"><i class="fa-solid fa-file-plus"></i> Create profile from this world</button><button type="button" data-action="showLibrary"><i class="fa-solid fa-folder-open"></i> Browse saved profiles</button><button type="button" data-action="chooseProfile"><i class="fa-solid fa-file-import"></i> Import a JSON file</button></div>
      <p class="hint">Per-user values, campaign identity, encounter Manual Mode, Automatic Rune Progression, Variant Rules, Settings Vault state, and hidden Core bookkeeping stay out. Native Core configuration sections are included for review.</p>
    {{/if}}
  {{/if}}
</div>
